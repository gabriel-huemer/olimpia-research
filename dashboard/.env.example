# Conexão com o banco de dados PostgreSQL central (../oto-db)
# Usa o papel oto_web conforme definido em ../oto-db/db/roles.sql e V003__permissoes.sql
DATABASE_URL=postgresql://oto_web:oto_web_secret@127.0.0.1:5432/oto
OTO_DB_HOST=127.0.0.1
OTO_DB_PORT=5432
OTO_DB_NAME=oto
OTO_DB_USER=oto_web
OTO_DB_PASSWORD=

# API de sincronizacao do app (papel oto_mobile). Use o OTO_MOBILE_PASSWORD de ../oto-db/.env
OTO_MOBILE_PASSWORD=

# Segredo que assina o cookie de sessão do painel (mínimo 32 caracteres). Sem ele, ninguém consegue entrar.
#   openssl rand -hex 32
AUTH_SECRET=

# Token que o app do pesquisador envia na sincronização (Authorization: Bearer ...). Mínimo 24 caracteres.
# Rode o app com --dart-define=SYNC_API_TOKEN=<o mesmo valor>.
SYNC_API_TOKEN=

# Mostra "DADOS FICTÍCIOS" no rodapé dos relatórios exportados (bancos de demonstração).
# OTO_DADOS_FICTICIOS=1
