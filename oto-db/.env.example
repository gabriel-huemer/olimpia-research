# Copie para .env e preencha TODAS as senhas. Nunca versione o .env.
# Gere senhas fortes SEM caracteres especiais (evita problemas com Docker/Make):
#   openssl rand -hex 24

OTO_DB_NAME=oto
OTO_DB_PORT=5432

# Dono do banco (migrações e backup). Não use este usuário na aplicação.
OTO_DB_ADMIN_USER=oto_admin
OTO_DB_ADMIN_PASSWORD=

# Perfis de acesso usados pelas aplicações:
# back-end do painel Web
OTO_WEB_PASSWORD=
# API de sincronização do app Mobile
OTO_MOBILE_PASSWORD=
# BI / consultas somente leitura
OTO_READONLY_PASSWORD=

# Primeiro administrador do painel Web (opcional; troque a senha depois do primeiro login)
OTO_APP_ADMIN_NAME=Administrador OTO
OTO_APP_ADMIN_EMAIL=
OTO_APP_ADMIN_PASSWORD=

# Só para o pgAdmin (docker compose --profile tools up -d)
PGADMIN_EMAIL=admin@oto.local
PGADMIN_PASSWORD=
